end;

Func AngleControl%();

view(data%);

dpVirt%:=VirtualChan(dpVirt%, Print$("(Ch(%d) - %f) * %f * %f", ChanAngle%, Level, Scale, -1), chanAngle%);
ChanTitle$(dpVirt%, "PosCorrected");
ChanShow(dpVirt%);
YRange(dpvirt%, -10, 110);

if okay% = 0 then
    Filenew%();
endif

return 1
end


Func ForceStart%();

view(data%);

if type% = 0 then
    dpvirtTorq%:=VirtualChan(dpvirtTorq%, Print$("((((Ch(%d)) / %f) - %f))", ChanTorque%, conv_torq, mvc_percent), chanTorque%);
else
    dpvirtTorq%:=VirtualChan(dpvirtTorq%, Print$("((((Ch(%d)) / %f) + %f))", ChanTorque%, conv_torq, mvc_percent), chanTorque%);
endif

ChanTitle$(dpvirtTorq%, "TorqCorrected");
ChanShow(dpvirtTorq%);
YRange(dpvirtTorq%, 10, -100);


dpVirtForce%:=VirtualChan(dpVirtForce%, Print$(" (Ch(%d) - Ch(%d))", ChanTorque%, chanTorque%), chanTorque%);
ChanTitle$(dpVirtForce%, "ArtificialAcc");
ChanShow(dpVirtForce%);
YRange(dpvirtForce%, -250, 250);

test% := 1;

if okay% = 0 then
    ForceNew%(); 
endif

return 1
end

Func ForceControl%();

view(data%);

if type% = 0 then
    VirtualChan(dpVirtForce%, Print$(" ((((Ch(%d)) / %f) - %f) / %f) * (%f / %f)", ChanTorque%, conv_torq, mvc_percent, inertia, 180.0, _pi), chanTorque%);
else
    VirtualChan(dpVirtForce%, Print$(" ((((Ch(%d)) / %f) + %f) / %f) * (%f / %f)", ChanTorque%, conv_torq, mvc_percent, inertia, 180.0, _pi), chanTorque%);
endif
    
'ChanTitle$(dpVirtForce%, "ArtificialAcc");
'ChanShow(dpVirtForce%);
'YRange(dpvirtForce%, -250, 250);

'if okay% = 0 then
 '   ForceNew%(); 
'endif

return 1
end

Func TimeControl%();

view(data%);

dpVirtTime%:=VirtualChan(dpVirtTime%, Print$("(Ch(%d) - Ch(%d)) + (WT(%f, %f)) * (%f)", ChanAngle%, ChanAngle%, maxtime(), maxtime()+7, -1), chanAngle%);
ChanTitle$(dpVirtTime%, "Timer");
ChanShow(dpVirtTime%);
YRange(dpvirtTime%, -5, 0);

if vibrONAngle% = 1 then
    TimeNew%();
endif

return 1
end

Func Settings%()

var ok%;
DlgCreate ("Title for the dialog");        'start new dialog
DlgGroup("General Settings",1,1,45,3);
DlgList   (1,"Gravity",track$[], 2, 22, 2);
DlgReal   (2, "Max Angle", -100.0, 100.0, 22, 3); 'real, range 1.0-5.0

DlgGroup("Force Settings",1,4,45,4);
DlgReal   (3, "Torq Conversion", 0.0, 100.0, 22, 5); 'real, range 1.0-5.0
DlgReal   (4, "Inertia", 0.0, 100.0, 22, 6); 'real, range 1.0-5.0
DlgReal   (5, "Resisting Torque", -200.0, 200.0, 22, 7); 'real, range 1.0-5.0 
'DlgReal   (6, "Time Diff", -2000.0, 2000.0, 22, 8); 'real, range 1.0-5.0 
'DlgReal   (7, "Current Time", -2000.0, 2000.0, 22, 9); 'real, range 1.0-5.0 
'DlgReal   (8, "Iso Acc", -2000.0, 2000.0, 22, 10); 'real, range 1.0-5.0 
'DlgReal   (9, "Scaled Angle", -2000.0, 2000.0, 22, 11); 'real, range 1.0-5.0 


DlgButton(0,"Close");
DlgButton(1,"Apply");

ok% := DlgShow(type%, max_angle, conv_torq, inertia, mvc_percent); 'show dialog

return 1
end

Func StartSearch%(); 'Function to start the search for the SenS-Device Signal
search% := 1;
return 1
end

Func StartTime%();
vibrONAngle% := 1;
return 1
end

Func quit%()
SampleStop();
FileClose(data%);
return 0
end